      "typeVersion": 4,
      "position": [860, 480]
    },
    {
      "parameters": {
        "jsCode": "const inp = $json;\nreturn [{ json: {\n  id: 'dec_' + Date.now(),\n  ts: new Date().toISOString(),\n  bcl_id: inp.bcl_id || '',\n  item_type: inp.subject_type || '',\n  item_id: inp.subject_id || '',\n  recommended_action: '',\n  decision: inp.decision || '',\n  decided_by: '',\n  reason: inp.reason || '',\n  outcome: '',\n  outcome_observed_at: ''\n}}];"
      },

      "id": "15100003-0000-0000-0000-000000000003",
      "name": "Read memory_commercial",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [640, 100]
    },
    {
      "parameters": {
        "jsCode": "const inp = $('Trigger Sub-workflow').first().json;\nconst now = Date.now();\nconst mode = inp.mode;\nconst limit = Number(inp.limit) || 20;\nconst rows = items.map(i => i.json).filter(r => {\n  if (r.expires_at && Date.parse(r.expires_at) < now) return false;\n  return true;\n});\nlet out = [];\nif (mode === 'READ_BY_SUBJECT') {\n  out = rows.filter(r => r.subject_id === inp.subject_id);\n} else if (mode === 'READ_BY_NICHE') {\n  out = rows.filter(r => String(r.fact || '').toLowerCase().includes(String(inp.niche || '').toLowerCase()) || String(r.source || '').toLowerCase().includes(String(inp.niche || '').toLowerCase()));\n}\nout = out.slice(0, limit);\nreturn [{ json: { mode, count: out.length, results: out } }];"
      },
      "id": "15100004-0000-0000-0000-000000000004",
      "name": "Filter facts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 100]
    },
    {
      "parameters": {
        "documentId": {"__rl": true, "value": "{{GOOGLE_SHEET_ID}}", "mode": "id"},
        "sheetName": {"__rl": true, "value": "memory_decisions", "mode": "name"},
        "options": {}
      },
      "id": "15100005-0000-0000-0000-000000000005",
      "name": "Read memory_decisions",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [640, 300]
    },
    {
      "parameters": {
        "jsCode": "const inp = $('Trigger Sub-workflow').first().json;\nconst limit = Number(inp.limit) || 20;\nconst rows = items.map(i => i.json).sort((a,b)=>String(b.ts||'').localeCompare(String(a.ts||''))).slice(0, limit);\nreturn [{ json: { mode: 'READ_RECENT_DECISIONS', count: rows.length, results: rows } }];"
      },
      "id": "15100006-0000-0000-0000-000000000006",
      "name": "Format recent decisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "jsCode": "const inp = $json;\nif (!inp.source || !String(inp.source).trim()) { throw new Error('WRITE_FACT requires source'); }\nconst conf = Number(inp.confidence);\nconst lowConf = !Number.isFinite(conf) || conf < 0.3;\nreturn [{ json: {\n  id: 'mem_' + Date.now(),\n  ts: new Date().toISOString(),\n  type: 'fact',\n  subject_id: inp.subject_id || '',\n  subject_type: inp.subject_type || '',\n  fact: inp.fact || '',\n  confidence: Number.isFinite(conf) ? conf : '',\n  source: inp.source,\n  expires_at: ''\n}}];"
      },
      "id": "15100007-0000-0000-0000-000000000007",
      "name": "Build fact row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

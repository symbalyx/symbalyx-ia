        "sheetName": {"__rl": true, "value": "business_control", "mode": "name"},
        "options": {}
      },
      "id": "18100006-0000-0000-0000-000000000006",
      "name": "Read business_control",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1040, 200]
    },
    {
      "parameters": {
        "jsCode": "// Cherche la ligne BCL et capture ai_initial_priority avant update\nconst inp = $('Auth & validate').first().json;\nconst bcl_id = inp.bcl_id;\nconst rows = items.map(i => i.json);\nconst row = rows.find(r => String(r.id) === bcl_id);\nif (!row) {\n  return [{ json: { _ok: false, _status: 404, _error: 'bcl_id not found: ' + bcl_id } }];\n}\nreturn [{ json: {\n  _ok: true,\n  _status: 200,\n  bcl_id,\n  decision: inp.decision,\n  decided_by: inp.decided_by,\n  decider_id: inp.decider_id || '',\n  reason: inp.reason,\n  // Snapshot pour memory_decisions\n  item_type: row.item_type || '',\n  item_id: row.item_id || '',\n  recommended_action: row.recommended_action || '',\n  ai_initial_priority: row.priority_level || '',\n  title: row.title || '',\n  email: row.email || '',\n  current_status: row.decision_status || ''\n}}];"
      },
      "id": "18100007-0000-0000-0000-000000000007",
      "name": "Find row & snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1260, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false, "typeValidation": "loose"},
          "conditions": [
            {"id": "ok2", "leftValue": "={{ $json._ok }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equals"}}
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "18100008-0000-0000-0000-000000000008",
      "name": "If found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1480, 200]
    },
    {
      "parameters": {
        "documentId": {"__rl": true, "value": "{{GOOGLE_SHEET_ID}}", "mode": "id"},
        "sheetName": {"__rl": true, "value": "business_control", "mode": "name"},
        "operation": "update",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.bcl_id }}",
            "decision_status": "={{ $json.decision }}",
            "decided_by": "={{ $json.decided_by }}",

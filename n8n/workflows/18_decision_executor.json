            {"id": "decision_status", "displayName": "decision_status", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": false, "type": "string"},
            {"id": "decided_by", "displayName": "decided_by", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": false, "type": "string"},
            {"id": "decider_id", "displayName": "decider_id", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": false, "type": "string"},
            {"id": "decided_at", "displayName": "decided_at", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": false, "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "18100009-0000-0000-0000-000000000009",
      "name": "Update business_control",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1700, 100]
    },
    {
      "parameters": {
        "jsCode": "// Construit la ligne memory_decisions pour append. ai_initial_priority capturée AVANT update.\n// On relit le snapshot depuis Find row & snapshot pour ne pas dépendre de la sortie du Sheets update.\nconst r = $('Find row & snapshot').first().json;\nreturn [{ json: {\n  id: 'dec_' + Date.now(),\n  ts: new Date().toISOString(),\n  bcl_id: r.bcl_id,\n  item_type: r.item_type || '',\n  item_id: r.item_id || '',\n  recommended_action: r.recommended_action || '',\n  ai_initial_priority: r.ai_initial_priority || '',\n  decision: r.decision,\n  decided_by: r.decided_by,\n  decider_id: r.decider_id || '',\n  reason: r.reason || '',\n  outcome: '',\n  outcome_observed_at: ''\n}}];"
      },
      "id": "1810000a-0000-0000-0000-00000000000a",
      "name": "Build memory_decision row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 100]
    },
    {
      "parameters": {
        "documentId": {"__rl": true, "value": "{{GOOGLE_SHEET_ID}}", "mode": "id"},
        "sheetName": {"__rl": true, "value": "memory_decisions", "mode": "name"},
        "operation": "append",
        "columns": {"mappingMode": "autoMapInputData", "matchingColumns": [], "schema": []},
        "options": {}
      },
      "id": "1810000b-0000-0000-0000-00000000000b",
      "name": "Append memory_decisions",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [2140, 100]
    },
    {
      "parameters": {
        "jsCode": "// Récupère le snapshot pour router. On passe l'objet d'origine pour le routing.\nconst snap = $('Find row & snapshot').first().json;\nreturn [{ json: snap }];"
      },
      "id": "1810000c-0000-0000-0000-00000000000c",
      "name": "Pass snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2360, 100]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {"conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "conditions": [
              {"id": "approved-followup", "leftValue": "={{ $json.decision }}", "rightValue": "approved", "operator": {"type": "string", "operation": "equals"}},
              {"id": "approved-followup-action", "leftValue": "={{ $json.recommended_action }}", "rightValue": "follow_up_24h", "operator": {"type": "string", "operation": "equals"}}
            ], "combinator": "and"}, "renameOutput": true, "outputKey": "follow_up"},
            {"conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "conditions": [
              {"id": "approved-quote", "leftValue": "={{ $json.decision }}", "rightValue": "approved", "operator": {"type": "string", "operation": "equals"}},
              {"id": "approved-quote-action", "leftValue": "={{ $json.recommended_action }}", "rightValue": "quote", "operator": {"type": "string", "operation": "equals"}}
            ], "combinator": "and"}, "renameOutput": true, "outputKey": "quote"},
            {"conditions": {"options": {"caseSensitive": false, "typeValidation": "loose"}, "conditions": [
              {"id": "approved-reminder", "leftValue": "={{ $json.decision }}", "rightValue": "approved", "operator": {"type": "string", "operation": "equals"}},
              {"id": "approved-reminder-action", "leftValue": "={{ $json.recommended_action }}", "rightValue": "reminder_2", "operator": {"type": "string", "operation": "startsWith"}}
            ], "combinator": "and"}, "renameOutput": true, "outputKey": "reminder"}
          ]
        },
        "options": {"fallbackOutput": "extra"}
      },
      "id": "1810000d-0000-0000-0000-00000000000d",
      "name": "Switch action",
      "type": "n8n-nodes-base.switch",

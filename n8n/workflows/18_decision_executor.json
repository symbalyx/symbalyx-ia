      "id": "18100001-0000-0000-0000-000000000001",
      "name": "Webhook /decision",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 380],
      "webhookId": "symbalyx-decision",
      "notes": "POST /webhook/symbalyx-decision  body: { bcl_id, decision, decided_by, reason? }  header: x-symbalyx-token"
    },
    {
      "parameters": {
        "jsCode": "// Auth + validation payload + normalisation\nconst h = $json.headers || {};\nconst token = h['x-symbalyx-token'] || h['X-Symbalyx-Token'] || '';\nconst expected = $env.SYMBALYX_WEBHOOK_SECRET || '';\nif (!expected) {\n  return [{ json: { _ok: false, _status: 500, _error: 'SYMBALYX_WEBHOOK_SECRET not configured on n8n' } }];\n}\nif (token !== expected) {\n  return [{ json: { _ok: false, _status: 401, _error: 'invalid_token' } }];\n}\nconst body = $json.body || {};\nconst bcl_id = String(body.bcl_id || '').trim();\nconst decision = String(body.decision || '').trim().toLowerCase();\nconst decided_by = String(body.decided_by || '').trim();\nconst decider_id = String(body.decider_id || '').trim();\nconst reason = String(body.reason || '').trim();\nconst ALLOWED = ['approved','rejected','snoozed','abandoned'];\nif (!bcl_id) return [{ json: { _ok: false, _status: 400, _error: 'missing bcl_id' } }];\nif (!ALLOWED.includes(decision)) return [{ json: { _ok: false, _status: 400, _error: 'invalid decision (must be one of '+ALLOWED.join(',')+')' } }];\nif (!decided_by) return [{ json: { _ok: false, _status: 400, _error: 'missing decided_by' } }];\nreturn [{ json: { _ok: true, bcl_id, decision, decided_by, decider_id, reason } }];"
      },
      "id": "18100002-0000-0000-0000-000000000002",
      "name": "Auth & validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false, "typeValidation": "loose"},
          "conditions": [
            {"id": "ok1", "leftValue": "={{ $json._ok }}", "rightValue": true, "operator": {"type": "boolean", "operation": "equals"}}
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "18100003-0000-0000-0000-000000000003",
      "name": "If valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [620, 380]
    },
    {
      "parameters": {
        "respondWith": "json",

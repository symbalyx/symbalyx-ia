        "options": {}
      },
      "id": "1810000e-0000-0000-0000-00000000000e",
      "name": "Mark review approved (→ WF2)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [2820, -100],
      "notes": "WF2 (cron 15min) lira ensuite cette ligne et créera le draft Gmail. Pas d'envoi auto."
    },
    {
      "parameters": {
        "jsCode": "// quote → flag pour WF5 (project brief). On marque human_decision=approved + reply_category=needs_quote pour bien router.\nreturn [{ json: { _action: 'quote', item_id: $json.item_id, message: 'Marqué pour devis (WF5 prendra le relais)' } }];"
      },
      "id": "1810000f-0000-0000-0000-00000000000f",
      "name": "Quote: prepare brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2820, 100]
    },
    {
      "parameters": {
        "jsCode": "// reminder_* → relancée par WF14 sur cron. On ne déclenche pas ici, on log juste l'approbation.\nreturn [{ json: { _action: 'reminder', item_id: $json.item_id, message: 'Approbation enregistrée pour relance (WF14 enverra le draft)' } }];"
      },
      "id": "18100010-0000-0000-0000-000000000010",
      "name": "Reminder: log only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2820, 260]
    },
    {
      "parameters": {
        "jsCode": "// Fallback: rejected / snoozed / abandoned / autres actions → pas d'exécution downstream, juste enregistrement.\nreturn [{ json: { _action: 'noop', item_id: $json.item_id, decision: $json.decision, message: 'Décision enregistrée sans action automatique' } }];"
      },

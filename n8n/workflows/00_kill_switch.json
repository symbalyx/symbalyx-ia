        "jsCode": "const rows = items.map(i => i.json);\nconst kv = {};\nfor (const r of rows) { if (r.key) kv[String(r.key).trim()] = String(r.value || '').trim(); }\nconst kill = String(kv.KILL_SWITCH || 'false').toLowerCase() === 'true';\nconst maxBatch = Number(kv.MAX_BATCH || 30);\nconst maxRunsPerHour = Number(kv.MAX_RUNS_PER_HOUR || 6);\nif (kill) { throw new Error('KILL_SWITCH_ACTIVE — exécution bloquée par config'); }\nreturn [{ json: { kill: false, max_batch: maxBatch, max_runs_per_hour: maxRunsPerHour, ...kv } }];"
      },

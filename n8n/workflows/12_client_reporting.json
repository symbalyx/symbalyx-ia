{
  "name": "Symbalyx — WF12 Client Reporting (weekly per project)",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "weeks", "weeksInterval": 1, "triggerAtDay": [5], "triggerAtHour": 16}]}},
      "id": "12100001-0000-0000-0000-000000000001",
      "name": "Schedule (vendredi 16h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 280]
    },
    {
      "parameters": {},
      "id": "12100002-0000-0000-0000-000000000002",
      "name": "Trigger Manuel",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 460]
    },
    {
      "parameters": {
        "documentId": {"__rl": true, "value": "{{GOOGLE_SHEET_ID}}", "mode": "id"},
        "sheetName": {"__rl": true, "value": "project_queue", "mode": "name"},
        "options": {}
      },
      "id": "12100003-0000-0000-0000-000000000003",
      "name": "Lire project_queue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [420, 360]
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of items) {\n  const p = it.json || {};\n  const status = String(p.status || '').toLowerCase();\n  if (['in_progress','new'].includes(status) && p.email) out.push({ json: p });\n}\nreturn out;"
      },
      "id": "12100004-0000-0000-0000-000000000004",
      "name": "Filtrer projets actifs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 360]
    },
    {
      "parameters": {"batchSize": 1, "options": {}},
      "id": "12100005-0000-0000-0000-000000000005",
      "name": "Boucle projet",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [860, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{LLM_API_URL}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"={{$env.LLM_MODEL || 'gpt-4o-mini'}}\",\n  \"temperature\": 0.4,\n  \"max_tokens\": 700,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    { \"role\": \"system\", \"content\": \"Tu rédiges un rapport hebdo client court (vouvoiement, ≤200 mots) pour Symbalyx. Pas de promesses prix/délais. Ce rapport sera relu par Arsène avant envoi (brouillon Gmail). JSON strict.\" },\n    { \"role\": \"user\", \"content\": \"Projet:\\n\" + {{ JSON.stringify($json) }} + \"\\n\\nRetourne STRICTEMENT: {\\n  \\\"subject\\\": \\\"Symbalyx — point semaine — \" + {{ JSON.stringify($json.client_name || 'projet') }} + \"\\\",\\n  \\\"body\\\": \\\"6-10 lignes : ce qui a avancé, ce qui est en cours, ce qu'on attend du client, prochaines étapes\\\",\\n  \\\"questions_for_client\\\": [\\\"...\\\"]\\n}\" }\n  ]\n}",
        "options": {"timeout": 30000, "response": {"response": {"neverError": true}}}
      },
      "id": "12100006-0000-0000-0000-000000000006",
      "name": "A12 — LLM Weekly Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 360],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const llm = $json; let r = {};\ntry { const c = llm.choices && llm.choices[0] && llm.choices[0].message && llm.choices[0].message.content; if (c) r = JSON.parse(c); } catch(e){ r = {}; }\nconst project = $('Boucle projet').first().json;\nreturn [{ json: {\n  id: 'rep_' + Date.now(),\n  ts: new Date().toISOString(),\n  project_id: project.id,\n  client_name: project.client_name,\n  email: project.email,\n  subject: r.subject || ('Symbalyx — point semaine — ' + (project.client_name || '')),\n  body: r.body || '',\n  questions_for_client: JSON.stringify(r.questions_for_client || []),\n  status: 'drafted_pending_review'\n}}];"
      },
      "id": "12100007-0000-0000-0000-000000000007",
      "name": "Format Rapport",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 360]
    },
    {
      "parameters": {
        "documentId": {"__rl": true, "value": "{{GOOGLE_SHEET_ID}}", "mode": "id"},
        "sheetName": {"__rl": true, "value": "client_reports", "mode": "name"},
        "operation": "append",
        "columns": {"mappingMode": "autoMapInputData", "matchingColumns": [], "schema": []},
        "options": {}
      },
      "id": "12100008-0000-0000-0000-000000000008",
      "name": "Append → client_reports",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1520, 360]
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {"sendTo": "={{ $json.email }}"}
      },
      "id": "12100009-0000-0000-0000-000000000009",
      "name": "Gmail Create Draft (client)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1740, 360],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Schedule (vendredi 16h)": { "main": [[{"node": "Lire project_queue", "type": "main", "index": 0}]] },
    "Trigger Manuel": { "main": [[{"node": "Lire project_queue", "type": "main", "index": 0}]] },
    "Lire project_queue": { "main": [[{"node": "Filtrer projets actifs", "type": "main", "index": 0}]] },
    "Filtrer projets actifs": { "main": [[{"node": "Boucle projet", "type": "main", "index": 0}]] },
    "Boucle projet": { "main": [[{"node": "A12 — LLM Weekly Report", "type": "main", "index": 0}], []] },
    "A12 — LLM Weekly Report": { "main": [[{"node": "Format Rapport", "type": "main", "index": 0}]] },
    "Format Rapport": { "main": [[{"node": "Append → client_reports", "type": "main", "index": 0}]] },
    "Append → client_reports": { "main": [[{"node": "Gmail Create Draft (client)", "type": "main", "index": 0}]] },
    "Gmail Create Draft (client)": { "main": [[{"node": "Boucle projet", "type": "main", "index": 0}]] }
  },
  "pinData": {},
  "settings": {"executionOrder": "v1"},
  "staticData": null,
  "tags": [{"name": "symbalyx"}, {"name": "reporting"}, {"name": "wf12"}],

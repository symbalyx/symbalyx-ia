      "id": "0c000001-0000-0000-0000-000000000001",
      "name": "Gmail Trigger (inbox poll)",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [200, 300],
      "notes": "Poll Gmail toutes les minutes pour les emails non lus."
    },
    {
      "parameters": {
        "jsCode": "// Extraire from / subject / body / message_id\nconst out = [];\nfor (const item of items) {\n  const r = item.json || {};\n  // n8n Gmail trigger returns headers in payload.headers and text in snippet/body\n  const fromRaw = (r.From || r.from || (r.payload && r.payload.headers && (r.payload.headers.find(h => h.name === 'From') || {}).value) || '').toString();\n  const subject = (r.Subject || r.subject || (r.payload && r.payload.headers && (r.payload.headers.find(h => h.name === 'Subject') || {}).value) || '').toString();\n  const text = (r.text || r.snippet || r.body || '').toString();\n  const messageId = (r.id || r.messageId || '').toString();\n\n  // Extract just the email\n  const m = fromRaw.match(/<([^>]+)>/);\n  const fromEmail = (m ? m[1] : fromRaw).trim().toLowerCase();\n\n  out.push({\n    json: {\n      reply_message_id: messageId,\n      reply_from: fromEmail,\n      reply_from_raw: fromRaw,\n      reply_subject: subject,\n      reply_text: text,\n      reply_received_at: new Date().toISOString()\n    }\n  });\n}\nreturn out;"
      },
      "id": "0c000002-0000-0000-0000-000000000002",
      "name": "Extraire champs email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "{{GOOGLE_SHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "review_queue",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "email",
              "lookupValue": "={{ $json.reply_from }}"
            }
          ]
        },
        "options": {}
      },
      "id": "0c000003-0000-0000-0000-000000000003",
      "name": "Lookup prospect par email",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [640, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false, "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-found",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {"type": "string", "operation": "notEmpty"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0c000004-0000-0000-0000-000000000004",
      "name": "If prospect connu ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "jsCode": "// Combine prospect (lookup result) + reply context (Extraire champs email)\nconst prospect = $json;\nconst reply = $('Extraire champs email').first().json;\nreturn [{\n  json: {\n    ...prospect,\n    reply_message_id: reply.reply_message_id,\n    reply_from: reply.reply_from,\n    reply_subject: reply.reply_subject,\n    reply_text: reply.reply_text,\n    reply_received_at: reply.reply_received_at\n  }\n}];"
      },
      "id": "0c000005-0000-0000-0000-000000000005",
      "name": "Merge prospect + reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{LLM_API_URL}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{"name": "Content-Type", "value": "application/json"}]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"={{$env.LLM_MODEL || 'gpt-4o-mini'}}\",\n  \"temperature\": 0,\n  \"max_tokens\": 300,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Tu es classifieur d'emails entrants pour Symbalyx. Catégories fermées: interested, not_interested, ask_later, wrong_contact, needs_quote, unclear. Détection opt_out (stop, ne plus contacter, désinscription) -> not_interested + opt_out_signal=true. Réponds JSON strict sans markdown.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Texte: \\\"\\\"\\\"\\n\" + {{ JSON.stringify($json.reply_text || '') }} + \"\\n\\\"\\\"\\\"\\n\\nSujet: \" + {{ JSON.stringify($json.reply_subject || '') }} + \"\\nDe: \" + {{ JSON.stringify($json.reply_from || '') }} + \"\\n\\nRetourne STRICTEMENT:\\n{\\n  \\\"category\\\": \\\"interested|not_interested|ask_later|wrong_contact|needs_quote|unclear\\\",\\n  \\\"confidence\\\": 0.0-1.0,\\n  \\\"opt_out_signal\\\": true|false,\\n  \\\"follow_up_hint\\\": \\\"ISO date si ask_later sinon null\\\",\\n  \\\"reason\\\": \\\"1 phrase\\\"\\n}\"\n    }\n  ]\n}",
        "options": {
          "timeout": 30000,
          "response": {"response": {"neverError": true}}
        }
      },
      "id": "0c000006-0000-0000-0000-000000000006",
      "name": "A4 — LLM Classify Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 220],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of items) {\n  const llm = item.json;\n  let parsed = {};\n  try {\n    const c = llm && llm.choices && llm.choices[0] && llm.choices[0].message && llm.choices[0].message.content;\n    if (!c) throw new Error('NO_CONTENT');\n    parsed = JSON.parse(c);\n  } catch (e) {\n    parsed = { category: 'unclear', confidence: 0, opt_out_signal: false, follow_up_hint: null, reason: 'parse_error: ' + (e && e.message) };\n  }\n  const prev = $('Merge prospect + reply').first().json;\n  out.push({\n    json: {\n      ...prev,\n      reply_category: parsed.category,\n      reply_confidence: parsed.confidence,\n      reply_opt_out_signal: parsed.opt_out_signal === true,\n      reply_follow_up_hint: parsed.follow_up_hint || '',\n      reply_reason: parsed.reason || '',\n      updated_at: new Date().toISOString()\n    }\n  });\n}\nreturn out;"
      },

            {"id": "reply_opt_out", "displayName": "reply_opt_out", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": false, "type": "string"},
            {"id": "updated_at", "displayName": "updated_at", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": false, "type": "string"}
          ]

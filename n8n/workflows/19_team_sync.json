      "parameters": {
        "jsCode": "// Auth + validation POST\nconst h = $json.headers || {};\nconst token = h['x-symbalyx-token'] || h['X-Symbalyx-Token'] || '';\nconst expected = $env.SYMBALYX_WEBHOOK_SECRET || '';\nif (!expected) return [{ json: { _ok: false, _status: 500, _error: 'SYMBALYX_WEBHOOK_SECRET not configured' } }];\nif (token !== expected) return [{ json: { _ok: false, _status: 401, _error: 'invalid_token' } }];\nconst b = $json.body || {};\nconst item_type = String(b.item_type || '').trim().toLowerCase();\nconst item_id = String(b.item_id || '').trim();\nconst author = String(b.author || '').trim();\nconst body = String(b.body || '').trim();\nconst parent_id = String(b.parent_id || '').trim();\nconst ALLOWED = ['bcl','prospect','project','invoice'];\nif (!ALLOWED.includes(item_type)) return [{ json: { _ok: false, _status: 400, _error: 'invalid item_type' } }];\nif (!item_id) return [{ json: { _ok: false, _status: 400, _error: 'missing item_id' } }];\nif (!author) return [{ json: { _ok: false, _status: 400, _error: 'missing author' } }];\nif (!body) return [{ json: { _ok: false, _status: 400, _error: 'empty body' } }];\nif (body.length > 2000) return [{ json: { _ok: false, _status: 400, _error: 'body too long (max 2000)' } }];\nreturn [{ json: { _ok: true, item_type, item_id, author, body, parent_id } }];"

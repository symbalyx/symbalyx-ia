        "jsCode": "const inp = $('Auth & validate GET').first().json;\nconst all = items.map(i => i.json);\nconst filtered = all.filter(c => String(c.item_type||'').toLowerCase() === inp.item_type && String(c.item_id||'') === inp.item_id);\nfiltered.sort((a,b) => String(a.ts||'').localeCompare(String(b.ts||'')));\nconst capped = filtered.slice(-inp.limit);\nreturn [{ json: { ok: true, item_type: inp.item_type, item_id: inp.item_id, count: capped.length, comments: capped } }];"

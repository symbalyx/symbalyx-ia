      "id": "13100003-0000-0000-0000-000000000003",
      "name": "Lire kb_articles",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [420, 380]
    },
    {
      "parameters": {
        "jsCode": "// Retrieval lexical simple (BM25-like). Pas d'embeddings pour l'instant — anti-coût.\nconst trigInputs = $('Trigger Sub-workflow').first() ? $('Trigger Sub-workflow').first().json : {};\nconst manualInputs = $input && $input.first ? ($input.first().json || {}) : {};\nconst query = String(trigInputs.query || manualInputs.query || '').toLowerCase().trim();\nconst topK = Number(trigInputs.top_k || manualInputs.top_k || 5);\nconst articles = items.map(i => i.json);\nfunction tokenize(s){ return String(s||'').toLowerCase().split(/[^a-z0-9àâçéèêëîïôûùüÿñ]+/).filter(Boolean); }\nconst qTokens = tokenize(query);\nconst stop = new Set(['le','la','les','un','une','de','du','des','et','ou','à','en','pour','par','sur','est','sont','que','qui','dans','avec','au','aux']);\nconst qFiltered = qTokens.filter(t => !stop.has(t));\nfunction score(a){\n  const text = (a.title || '') + ' ' + (a.body || '') + ' ' + (a.tags || '');\n  const tt = tokenize(text);\n  const tset = new Set(tt);\n  let s = 0;\n  for (const t of qFiltered) {\n    if (tset.has(t)) s += 1;\n    // partial match\n    for (const tk of tt) { if (tk.includes(t) && tk !== t) { s += 0.3; break; } }\n  }\n  // boost si tag matched exact\n  const tags = String(a.tags || '').toLowerCase();\n  for (const t of qFiltered) if (tags.includes(t)) s += 0.5;\n  return s;\n}\nconst ranked = articles\n  .map(a => ({ a, s: score(a) }))\n  .filter(x => x.s > 0)\n  .sort((x,y) => y.s - x.s)\n  .slice(0, topK)\n  .map(x => ({ id: x.a.id, title: x.a.title, excerpt: String(x.a.body || '').slice(0, 400), tags: x.a.tags, score: x.s }));\nreturn [{ json: { query, top_k: topK, results: ranked } }];"
      },

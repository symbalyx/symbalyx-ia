      "name": "Trigger Manuel",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [200, 480]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "{{GOOGLE_SHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "review_queue",
          "mode": "name"
        },
        "options": {}
      },
      "id": "0b000003-0000-0000-0000-000000000003",
      "name": "Lire review_queue",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [440, 380]
    },
    {
      "parameters": {
        "jsCode": "// Filtre: human_decision == 'approved' ET status != 'drafted_in_gmail' ET non vide\nconst out = [];\nfor (const item of items) {\n  const r = item.json || {};\n  const decision = String(r.human_decision || '').trim().toLowerCase();\n  const status = String(r.status || '').trim().toLowerCase();\n  if (decision === 'approved' && status !== 'drafted_in_gmail' && status !== 'sent') {\n    out.push({ json: r });\n  }\n}\nreturn out;"
      },
      "id": "0b000004-0000-0000-0000-000000000004",
      "name": "Filtrer approved & non draftés",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 380]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "0b000005-0000-0000-0000-000000000005",
      "name": "Boucle (1 par 1)",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [880, 380]
    },
    {
      "parameters": {
        "jsCode": "// Anti-double-draft: vérifier opt_out une dernière fois et préparer le draft\nconst r = $json;\nconst optOut = r.opt_out === true || String(r.opt_out || '').toLowerCase() === 'true';\nif (optOut) {\n  return [{ json: { ...r, _skip: true, _skip_reason: 'opt_out' } }];\n}\nif (!r.email || !r.draft_email_subject || !r.draft_email_body) {\n  return [{ json: { ...r, _skip: true, _skip_reason: 'missing_fields' } }];\n}\nreturn [{ json: { ...r, _skip: false } }];"
      },
      "id": "0b000006-0000-0000-0000-000000000006",
      "name": "Pré-check sécurité",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": false, "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-skip",
              "leftValue": "={{ $json._skip }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "equals"}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0b000007-0000-0000-0000-000000000007",
      "name": "If skip ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 380]
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "={{ $json.draft_email_subject }}",
        "emailType": "text",
        "message": "={{ $json.draft_email_body }}",
        "options": {
          "sendTo": "={{ $json.email }}"
        }
      },
      "id": "0b000008-0000-0000-0000-000000000008",
      "name": "Gmail Create Draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1540, 280],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput",
      "notes": "Crée un brouillon Gmail. JAMAIS Send."
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "{{GOOGLE_SHEET_ID}}",
          "mode": "id"
        },
        "sheetName": {

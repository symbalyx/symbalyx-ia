# ============ LLM (provider-agnostic, OpenAI-compatible) ============
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=gpt-4o-mini
LLM_MODEL_PREMIUM=gpt-4o
LLM_TIMEOUT_MS=30000

# ============ Google Sheets ============
GOOGLE_SHEET_ID=REPLACE_WITH_YOUR_SHEET_ID

# Onglets (noms)
PROSPECTS_SHEET=prospects_in
REVIEW_QUEUE_SHEET=review_queue
PROJECT_QUEUE_SHEET=project_queue
TEAM_STATE_SHEET=team_state
WEEKLY_RECOS_SHEET=weekly_recommendations
BUSINESS_CONTROL_SHEET=business_control
KPI_SNAPSHOTS_SHEET=kpi_snapshots
LOGS_SHEET=logs
CONFIG_SHEET=config
CLIENT_ONBOARDING_SHEET=client_onboarding
CLIENT_REPORTS_SHEET=client_reports
KB_ARTICLES_SHEET=kb_articles
INVOICES_SHEET=invoices
USERS_SHEET=users

# ============ Equipe ============
ARSENE_NAME=Arsène
KENTIN_NAME=Kentin
INTERNAL_DIGEST_TO=arsene+kentin@symbalyx.local

# ============ Limites ============
MAX_PROSPECTS_PER_RUN=25
MAX_BCL_BATCH=30
WAIT_MS_BETWEEN_PROSPECTS=1500

# ============ Webhooks CRM ↔ n8n (V7) ============
# Secret partagé envoyé par le CRM en header `x-symbalyx-token` et vérifié par WF18/WF19.
# Génère une chaîne longue et aléatoire (>= 32 chars). Configure-la côté n8n (variable d'env)
# ET côté CRM (Réglages → Webhook n8n).
SYMBALYX_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

